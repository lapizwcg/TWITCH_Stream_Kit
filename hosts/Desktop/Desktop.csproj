<Project Sdk="Microsoft.NET.Sdk">
  <!-- ХОСТ ПК: окно SDL2 + OpenGL — проверка и снимки (ключ shot). Данные — из папок проекта (Paths: метка wcg.root) -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>disable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <ImplicitUsings>disable</ImplicitUsings>
    <InvariantGlobalization>true</InvariantGlobalization>
    <AssemblyName>KitDesktop</AssemblyName>
    <TieredCompilation>false</TieredCompilation>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../../src/Kit/Kit.csproj" />
    <None Include="../../../WCGEngine/native/win-x64/SDL2.dll" CopyToOutputDirectory="PreserveNewest" Link="SDL2.dll" />
  </ItemGroup>
</Project>
