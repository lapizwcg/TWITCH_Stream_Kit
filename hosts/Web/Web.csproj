<Project Sdk="Microsoft.NET.Sdk.WebAssembly">
  <!-- ХОСТ БРАУЗЕРА: .NET wasm + WebGL2 (мост движка WCGEngine/src/WcgEngine/Web/wcg.js) — страница-оверлей для источника-браузера
       OBS, холст прозрачный. Сборка: dotnet publish hosts/Web -c Release -o pub/web → pub/web/wwwroot (любой статический сервер).
       Данные — в виртуальной файловой системе .NET по тем же путям, что на ПК: код загрузки один (Boot.cs) -->
  <PropertyGroup>
    <TargetFramework>net10.0-browser</TargetFramework>
    <Nullable>disable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <ImplicitUsings>disable</ImplicitUsings>
    <InvariantGlobalization>true</InvariantGlobalization>
    <AssemblyName>KitWeb</AssemblyName>
    <OverrideHtmlAssetPlaceholders>true</OverrideHtmlAssetPlaceholders>
    <RunAOTCompilation>true</RunAOTCompilation>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../../src/Kit/Kit.csproj" />
    <StaticWebAssetFingerprintPattern Include="JS" Pattern="*.js" Expression="#[.{fingerprint}]!" />
    <GameFile Include="../../wcg.root" Dest="wcg.root" />
    <GameFile Include="../../data/*.json" Dest="data/%(Filename)%(Extension)" />
    <GameFile Include="../../data/font/font.bin;../../data/font/font.png" Dest="data/font/%(Filename)%(Extension)" />
  </ItemGroup>
  <!-- мост движка и файлы — рядом со страницей (копии при сборке, в git не хранятся: источник один) -->
  <Target Name="CopyGameFiles" BeforeTargets="BeforeBuild">
    <Copy SourceFiles="../../../WCGEngine/src/WcgEngine/Web/wcg.js" DestinationFolder="wwwroot" SkipUnchangedFiles="true" />
    <Copy SourceFiles="@(GameFile)" DestinationFiles="@(GameFile->'wwwroot/game/%(Dest)')" SkipUnchangedFiles="true" />
    <WriteLinesToFile File="wwwroot/game/files.txt" Lines="@(GameFile->'%(Dest)')" Overwrite="true" WriteOnlyWhenDifferent="true" />
  </Target>
</Project>
